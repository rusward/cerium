// arithmetic.hy - integer and floating point operators.
int a = 17;
int b = 5;

log("a + b =", a + b);
log("a - b =", a - b);
log("a * b =", a * b);
log("a / b =", a / b);
log("a % b =", a % b);

double x = 7.5;
double y = 2.5;

log("x + y =", x + y);
log("x / y =", x / y);
log("x > y =", x > y);
log("x == 7.5 =", x == 7.5);
